{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@shared/*": [
        "../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
