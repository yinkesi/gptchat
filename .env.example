# ---- gptchat server configuration ----
# Copy to .env and adjust. NEVER commit the real .env.

# Listening address/port
HOST=127.0.0.1
PORT=8780

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED in production — the server refuses to start without it when NODE_ENV=production.
JWT_SECRET=

# Public URL of this deployment (used for CORS allowlist defaults / docs)
PUBLIC_URL=http://localhost:8780

# Extra origins allowed to call the API (comma separated), e.g. vite dev server
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file
DB_PATH=./data/gptchat.db

# Trust the X-Forwarded-* headers (set to 1 only when behind a reverse proxy)
TRUST_PROXY=0

# Console noise
LOG_LEVEL=info
